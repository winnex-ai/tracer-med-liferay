# API key used to authenticate the Liferay bridge -> microservice channel.
# In production this MUST be a strong random value, shared with Liferay's
# System Settings (Winnex Madhava Service -> apiKey).
# Example only -- never ship a real key.
MADHAVA_API_KEY=change-me-in-production

# Port the service listens on
MADHAVA_PORT=8600

# Evidence WORM path (append-only audit chain)
TRACER_MED_EVIDENCE_PATH=/var/lib/tracer-med/evidence
