# API key used to authenticate the Liferay bridge -> microservice channel.
# REQUIRED. Generate a strong random value (e.g. `openssl rand -hex 32`) and
# configure THE SAME value in Liferay's System Settings → "Winnex Madhava
# Service" → apiKey. The OSGi bundle (MadhavaServiceHttpImpl) must send this
# key as `X-Winnex-Api-Key`; without it the microservice returns 401.
#
# IMPORTANT: do NOT use the placeholder below — leaving `change-me-in-production`
# in a deployed environment makes the channel effectively open and masks the
# 401 regression when the bundle forgets to send the header.
MADHAVA_API_KEY=

# Port the service listens on
MADHAVA_PORT=8600

# Evidence WORM path (append-only audit chain)
TRACER_MED_EVIDENCE_PATH=/var/lib/tracer-med/evidence
